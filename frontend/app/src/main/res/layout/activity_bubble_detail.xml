<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景 bg_chat_bubblebg.webp -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_chat_bubblebg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp" />

    <!-- 左上角返回图标 -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:elevation="4dp"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_bg" />

    <!-- 右上角设置图标 -->
    <ImageView
        android:id="@+id/btn_setting"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:elevation="4dp"
        android:src="@drawable/ic_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_bg" />

    <!-- 聊天名称 -->
    <TextView
        android:id="@+id/tv_chat_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="蛋蛋后杰迷"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/inter_bold"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_bg" />

    <!-- 灰色横线 -->
    <View
        android:id="@+id/divider_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#66FFFFFF"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_chat_name" />

    <!-- 消息列表区域 (占位) -->
    <View
        android:id="@+id/message_list_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_line"
        android:layout_marginTop="20dp" />

    <!-- This Bubble Label 文字 -->
    <TextView
        android:id="@+id/tv_bubble_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This Bubble Label :"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/gloriahallelujah"
        android:letterSpacing="-0.02"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/message_list_area" />

    <!-- Bubble Label 标签显示区域 (水平流式布局) -->
    <LinearLayout
        android:id="@+id/layout_bubble_labels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bubble_label" />

    <!-- Age : 标签文字 -->
    <TextView
        android:id="@+id/tv_age_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Age :"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/gloriahallelujah"
        android:letterSpacing="-0.02"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_bubble_labels" />

    <!-- Age 值显示 -->
    <TextView
        android:id="@+id/tv_age_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_age_label"
        app:layout_constraintTop_toTopOf="@id/tv_age_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_age_label" />

    <!-- Gender : 标签文字 -->
    <TextView
        android:id="@+id/tv_gender_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender :"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/gloriahallelujah"
        android:letterSpacing="-0.02"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_age_label" />

    <!-- 性别值显示（跟在 Gender : 后面同一行） -->
    <TextView
        android:id="@+id/tv_gender_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tv_gender_label"
        app:layout_constraintTop_toTopOf="@id/tv_gender_label"
        app:layout_constraintBottom_toBottomOf="@id/tv_gender_label" />

    <!-- 泡泡卡片 (从 fragment_square_bubblewall 导入) -->
    <FrameLayout
        android:id="@+id/bubble_card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_gender_value"
        app:layout_constraintBottom_toTopOf="@+id/white_rounded_box">

        <ImageView
            android:id="@+id/iv_bubble_card_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/ic_square_bubblecardone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- 标题行：头像 + 名称 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="55dp"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_bubble_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_square_bubble" />

                <TextView
                    android:id="@+id/tv_bubble_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <!-- 内容文本 -->
            <TextView
                android:id="@+id/tv_bubble_card_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="30dp"
                android:lineSpacingMultiplier="1.0"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:maxLines="10"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <!-- 白色圆角长方形 - Join 按钮 -->
    <FrameLayout
        android:id="@+id/white_rounded_box"
        android:layout_width="277dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_white_rounded"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/btn_join"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Join"
            android:textColor="#F99C9C"
            android:textSize="18sp"
            android:fontFamily="@font/archivo_black"
            android:lineSpacingMultiplier="1.4"
            android:gravity="center" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>